# Supabase Edge Functions — Environment Variables
# These are set via `supabase secrets set` or the Supabase dashboard.
# They are NOT committed to Git.

# Available automatically in Edge Functions:
# - SUPABASE_URL
# - SUPABASE_ANON_KEY
# - SUPABASE_SERVICE_ROLE_KEY
# - SUPABASE_DB_URL

# Custom secrets (add as needed):
# Set via: npx supabase secrets set MY_SECRET=value
